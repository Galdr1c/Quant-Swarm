{
  "name": "@quant-swarm/api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "./dist/pipeline.js",
  "scripts": {
    "build": "tsc",
    "build:deps": "pnpm -r --filter @quant-swarm/shared --filter @quant-swarm/strategy-schema --filter @quant-swarm/market-data --filter @quant-swarm/risk-contracts --filter @quant-swarm/research-ledger --filter @quant-swarm/ai-orchestrator build",
    "test": "vitest run --passWithNoTests",
    "pipeline": "pnpm run build:deps && tsc && node dist/pipeline.js",
    "research:run": "pnpm run build:deps && tsc && node dist/research.js",
    "live:scan": "pnpm run build:deps && tsc && node dist/live.js",
    "live:intelligence": "pnpm run build:deps && tsc && node dist/intelligence.js"
  },
  "dependencies": {
    "@quant-swarm/shared": "workspace:*",
    "@quant-swarm/strategy-schema": "workspace:*",
    "@quant-swarm/market-data": "workspace:*",
    "@quant-swarm/risk-contracts": "workspace:*",
    "@quant-swarm/ai-orchestrator": "workspace:*",
    "@quant-swarm/research-ledger": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
