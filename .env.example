# ===========================
# Quant Swarm Configuration
# ===========================

# Trading Mode: shadow | paper | live
TRADING_MODE=shadow

# Kill switch — must be explicitly set to true to enable live trading
LIVE_TRADING_ENABLED=false

# ===========================
# Risk Limits
# ===========================
MAX_PORTFOLIO_EXPOSURE_PCT=50
MAX_SYMBOL_EXPOSURE_PCT=10
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=15
MAX_LEVERAGE=3

# ===========================
# Python Quant Engine
# ===========================
QUANT_ENGINE_URL=http://localhost:8420

# ===========================
# AI Providers (Phase 3+)
# ===========================
# OPENAI_API_KEY=sk-...
# KIMI_API_KEY=...

# ===========================
# Exchange APIs (Phase 2+)
# ===========================
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# ===========================
# Database (Phase 6+)
# ===========================
# DATABASE_URL=postgresql://localhost:5432/quant_swarm
