# ===========================
# Quant Swarm Configuration
# ===========================

# Trading Mode: shadow | paper | live
TRADING_MODE=shadow
LIVE_TRADING_ENABLED=false

# ===========================
# Risk Limits
# ===========================
MAX_PORTFOLIO_EXPOSURE_PCT=50
MAX_SYMBOL_EXPOSURE_PCT=10
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=15
MAX_LEVERAGE=3

# ===========================
# Python Quant Engine
# ===========================
QUANT_ENGINE_URL=http://localhost:8420

# ===========================
# Universal Live Candle Scanner (Milestone 9)
# ===========================
# tradingview is the default universal source. Direct exchange adapters remain
# available for crypto-specific fallback/testing: binance | bybit | hyperliquid
MARKET_PROVIDER=tradingview
# For TradingView use EXCHANGE:SYMBOL:timeframe. The final colon separates the timeframe.
# Mix crypto, stocks, forex, indices and commodities in the same scanner.
MARKET_SUBSCRIPTIONS=BINANCE:BTCUSDT:15m,NASDAQ:AAPL:15m,OANDA:EURUSD:15m,TVC:GOLD:1h
MARKET_BUFFER_SIZE=500
SCANNER_LOOKBACK_WINDOW=100
SCANNER_Z_THRESHOLD=3

# TradingView works anonymously for normal public chart access. These cookies
# are optional and only needed when your TradingView account is required for a
# symbol/history/feature. Never commit real cookie values.
# TRADINGVIEW_SESSION_ID=
# TRADINGVIEW_SESSION_SIGNATURE=
# regular | extended (optional; unset lets TradingView choose the default)
# TRADINGVIEW_MARKET_SESSION=regular
TRADINGVIEW_SMOKE_TIMEOUT_MS=20000

# spot | linear | inverse (Bybit direct candle adapter only)
BYBIT_CATEGORY=linear

# ===========================
# Crypto Market Intelligence (Milestone 3)
# ===========================
# These direct venue feeds are intentionally retained because TradingView is not
# the source of truth for exchange order books, liquidations, funding or OI.
# binance | bybit | hyperliquid
INTELLIGENCE_PROVIDER=binance
# Binance/Bybit use contract symbols; Hyperliquid can use native coins (BTC,ETH)
INTELLIGENCE_SYMBOLS=BTCUSDT,ETHUSDT
INTELLIGENCE_POLL_MS=5000
INTELLIGENCE_DEPTH_LEVELS=50
INTELLIGENCE_HISTORY_SIZE=120
ORDERBOOK_IMBALANCE_THRESHOLD=0.35
FUNDING_RATE_THRESHOLD=0.0005
OPEN_INTEREST_CHANGE_PCT_THRESHOLD=2
OPEN_INTEREST_LOOKBACK_SAMPLES=12
BASIS_BPS_THRESHOLD=10
SPREAD_BPS_THRESHOLD=5
LIQUIDATION_WINDOW_MS=60000
LIQUIDATION_USD_THRESHOLD=1000000
INTELLIGENCE_VOLATILITY_BPS_THRESHOLD=25
INTELLIGENCE_VOLATILITY_LOOKBACK_SAMPLES=20
INTELLIGENCE_CANDIDATE_COOLDOWN_MS=60000
INTELLIGENCE_LOG_SNAPSHOTS=false

# Optional public endpoint overrides. No exchange trading keys are used.
# BINANCE_FUTURES_REST_URL=https://fapi.binance.com
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market
# BYBIT_REST_URL=https://api.bybit.com
# BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
# HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info

# ===========================
# Research Search / AI Agents (Milestones 5-8)
# ===========================
# Comma-separated agent entries: mock | openai | astra | kimi
# Keep at least two entries so selection-bias evidence can be evaluated.
RESEARCH_PROVIDERS=mock,mock,mock
RESEARCH_MAX_CONCURRENCY=3
RESEARCH_AGENT_TIMEOUT_MS=90000
# jsonl for local/dev; postgres for durable multi-worker deployments.
RESEARCH_LEDGER_BACKEND=jsonl
RESEARCH_LEDGER_PATH=.data/research-ledger.jsonl
RESEARCH_POSTGRES_SCHEMA=quant_swarm
# Required only when RESEARCH_LEDGER_BACKEND=postgres.
# DATABASE_URL=postgresql://quant_swarm:change-me@localhost:5432/quant_swarm
# Optional fixed run id; leave unset for a timestamp-based id.
# RESEARCH_RUN_ID=

# Milestone 8 Postgres run leases. A worker heartbeats before the lease expires;
# a different worker may reclaim an abandoned RUNNING run only after expiry.
# Use a stable pod/host identifier when available; otherwise one is generated.
# RESEARCH_WORKER_ID=quant-worker-01
RESEARCH_RUN_LEASE_MS=120000
RESEARCH_RUN_HEARTBEAT_MS=30000

RESEARCH_CV_SPLITS=5
RESEARCH_PURGE_BARS=1
RESEARCH_EMBARGO_BARS=1

# Deterministic regime robustness calibration. Thresholds are learned only from
# the earlier discovery slice and then frozen for validation/OOS evidence.
RESEARCH_REGIME_LOOKBACK=48
RESEARCH_REGIME_VOL_QUANTILE=0.67
RESEARCH_REGIME_TREND_QUANTILE=0.67

# Provider credentials are only used by research agents. They are never written
# to the research ledger and are never exposed to exchange execution code.
# OPENAI_API_KEY=sk-...
OPENAI_RESEARCH_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
# KIMI_API_KEY=sk-...
KIMI_RESEARCH_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high

# ===========================
# Exchange Execution APIs (disabled; future milestone)
# ===========================
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
