# ===========================
# Quant Swarm Configuration
# ===========================

TRADING_MODE=shadow
LIVE_TRADING_ENABLED=false

# Risk
MAX_PORTFOLIO_EXPOSURE_PCT=50
MAX_SYMBOL_EXPOSURE_PCT=10
MAX_DAILY_LOSS_PCT=3
MAX_DRAWDOWN_PCT=15
MAX_LEVERAGE=3

# Quant engine
QUANT_ENGINE_URL=http://localhost:8420

# ===========================
# TradingView Market Data
# ===========================
# TradingView is the only external live/historical market-data source.
# Format: EXCHANGE:SYMBOL:timeframe; the final colon separates timeframe.
# BINANCE:BTCUSDT is a TradingView symbol ID. Quant-Swarm does not call Binance.
MARKET_SUBSCRIPTIONS=BINANCE:BTCUSDT:15m,NASDAQ:AAPL:15m,OANDA:EURUSD:15m,TVC:GOLD:1h
MARKET_BUFFER_SIZE=500
SCANNER_LOOKBACK_WINDOW=100
SCANNER_Z_THRESHOLD=3

# Anonymous TradingView access is the default. Optional account cookies:
# TRADINGVIEW_SESSION_ID=
# TRADINGVIEW_SESSION_SIGNATURE=
# TRADINGVIEW_MARKET_SESSION=regular
TRADINGVIEW_SMOKE_TIMEOUT_MS=20000

# ===========================
# Multi-Asset Universe Research
# ===========================
# TradingView-qualified EXCHANGE:SYMBOL:timeframe entries.
UNIVERSE_SUBSCRIPTIONS=BINANCE:BTCUSDT:4h,BINANCE:ETHUSDT:4h,NASDAQ:AAPL:1h,NASDAQ:NVDA:1h,NASDAQ:MSFT:1h,OANDA:EURUSD:1h,OANDA:USDJPY:1h,TVC:GOLD:4h
UNIVERSE_HISTORY_BARS=800
UNIVERSE_CONCURRENCY=2
UNIVERSE_Z_THRESHOLD=2.5
UNIVERSE_REPORT_PATH=.data/universe-report.json
# Optional override for PSR annualization across all universe entries.
# UNIVERSE_ANNUALIZATION=

# Dashboard reads the generated universe report and falls back to labeled demo data.
QUANT_REPORT_PATH=.data/universe-report.json
QUANT_DASHBOARD_PORT=4173

# ===========================
# Research Search / AI Agents
# ===========================
RESEARCH_PROVIDERS=mock,mock,mock
RESEARCH_MAX_CONCURRENCY=3
RESEARCH_AGENT_TIMEOUT_MS=90000

RESEARCH_LEDGER_BACKEND=jsonl
RESEARCH_LEDGER_PATH=.data/research-ledger.jsonl
RESEARCH_POSTGRES_SCHEMA=quant_swarm
# DATABASE_URL=postgresql://quant_swarm:change-me@localhost:5432/quant_swarm
# RESEARCH_RUN_ID=

# Postgres run leases
# RESEARCH_WORKER_ID=quant-worker-01
RESEARCH_RUN_LEASE_MS=120000
RESEARCH_RUN_HEARTBEAT_MS=30000

RESEARCH_CV_SPLITS=5
RESEARCH_PURGE_BARS=1
RESEARCH_EMBARGO_BARS=1

RESEARCH_REGIME_LOOKBACK=48
RESEARCH_REGIME_VOL_QUANTILE=0.67
RESEARCH_REGIME_TREND_QUANTILE=0.67

# AI credentials are only for hypothesis generation and are never persisted.
# OPENAI_API_KEY=sk-...
OPENAI_RESEARCH_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
# KIMI_API_KEY=sk-...
KIMI_RESEARCH_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high
